{
  "name": "forgejo-cli",
  "version": "0.1.0",
  "description": "Agent-first CLI for Forgejo pull requests, issues, milestones, labels, and releases",
  "type": "module",
  "packageManager": "bun@1.3.6",
  "bin": {
    "forgejo": "dist/bin/forgejo.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/bin/forgejo.ts --target=node --format=esm --outfile=dist/bin/forgejo.js",
    "build:binary": "bun build src/bin/forgejo.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile=artifacts/forgejo",
    "smoke:artifact": "bun scripts/smoke-cli-artifact.ts",
    "prepack": "bun run build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "audit": "bun audit",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run coverage && bun run build && bun run audit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdrianSilaghi/forgejo-cli.git"
  },
  "bugs": {
    "url": "https://github.com/AdrianSilaghi/forgejo-cli/issues"
  },
  "homepage": "https://github.com/AdrianSilaghi/forgejo-cli#readme",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "commander": "^14.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "fast-check": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
