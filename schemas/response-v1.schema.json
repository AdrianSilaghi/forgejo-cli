{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AdrianSilaghi/forgejo-cli/schemas/response-v1.schema.json",
  "title": "forgejo-cli response envelope v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "ok", "data"],
      "properties": {
        "schema_version": { "const": "1" },
        "ok": { "const": true },
        "data": true
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "ok", "error"],
      "properties": {
        "schema_version": { "const": "1" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable", "details"],
          "properties": {
            "code": {
              "enum": [
                "validation_failed",
                "confirmation_required",
                "not_authenticated",
                "forbidden",
                "not_found",
                "conflict",
                "rate_limited",
                "network_failed",
                "timeout",
                "server_failed",
                "protocol_failed",
                "config_failed",
                "credential_store_unavailable",
                "cancelled"
              ]
            },
            "message": { "type": "string" },
            "retryable": { "type": "boolean" },
            "details": { "type": "object" }
          }
        }
      }
    }
  ]
}
